{
  "name": "solidmaterial",
  "private": true,
  "license": "Apache-2.0",
  "author": "Mark Provo Kluit",
  "scripts": {
    "husky": "husky",
    "build": "turbo build",
    "build:storybook": "turbo storybook:build --filter=@solidmaterial/material",
    "site:build": "pnpm run build && pnpm run build:storybook && pnpm run site:copy-storybook && pnpm run site:copy-calculator",
    "site:copy-storybook": "cp -r packages/material/storybook-static apps/landing-page/dist/storybook",
    "site:copy-calculator": "cp -r apps/calculator/dist apps/landing-page/dist/calculator",
    "dev": "turbo dev --filter=@solidmaterial/landing-page --ui tui",
    "preview": "turbo preview --filter=@solidmaterial/landing-page --ui tui",
    "storybook": "turbo storybook --filter=@solidmaterial/material",
    "test": "turbo test --concurrency 1",
    "lint": "turbo lint",
    "format": "pnpm oxfmt",
    "format:check": "pnpm oxfmt --check",
    "install:chromium": "pnpm --filter=@solidmaterial/material exec playwright install chromium --with-deps",
    "install:webkit": "pnpm --filter=@solidmaterial/material exec playwright install webkit --with-deps"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@tsconfig/strictest": "2.0.8",
    "husky": "9.1.7",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "oxlint-tsgolint": "0.23.0",
    "turbo": "2.10.11",
    "typescript": "6.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "=11.22"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
