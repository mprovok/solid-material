{
  "name": "@solidmaterial/material",
  "version": "1.2.0",
  "private": false,
  "description": "Material 3 Expressive for SolidJS",
  "keywords": [
    "components",
    "design system",
    "expressive",
    "material",
    "material design",
    "solid",
    "solidjs",
    "ui"
  ],
  "homepage": "https://solid-material.sites.deploybase.eu/",
  "bugs": "https://github.com/mprovok/solid-material/issues",
  "license": "Apache-2.0",
  "author": "Mark Provo Kluit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mprovok/solid-material.git",
    "directory": "packages/material"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./components/*": {
      "types": "./src/components/*/index.d.ts",
      "default": "./src/components/*/index.ts"
    },
    "./layouts": {
      "types": "./src/layouts/index.d.ts",
      "default": "./src/layouts/index.ts"
    },
    "./styling": {
      "types": "./src/styling/index.d.ts",
      "default": "./src/styling/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.d.ts",
      "default": "./src/utils/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      "./components/*": {
        "types": "./dist/components/*/index.d.ts",
        "default": "./dist/components/*/index.js"
      },
      "./layouts": {
        "types": "./dist/layouts/index.d.ts",
        "default": "./dist/layouts/index.js"
      },
      "./styling": {
        "types": "./dist/styling/index.d.ts",
        "default": "./dist/styling/index.js"
      },
      "./utils": {
        "types": "./dist/utils/index.d.ts",
        "default": "./dist/utils/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test:chromium": "vitest run --browser chromium",
    "test:webkit": "vitest run --coverage --browser webkit",
    "test": "pnpm run test:webkit",
    "lint": "oxlint --report-unused-disable-directives",
    "lint:fix": "oxlint --fix --report-unused-disable-directives",
    "storybook": "storybook dev --port 6006 --no-version-updates --no-open --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry",
    "storybook:preview": "vite preview --host --port 4000 --outDir storybook-static"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "5.2.8",
    "@material/material-color-utilities": "0.4.0",
    "@material/web": "2.4.1",
    "@solid-primitives/active-element": "3.0.0-next.2",
    "@solid-primitives/focus": "1.0.0-next.4",
    "@solid-primitives/interaction": "1.0.0-next.4",
    "@solid-primitives/intersection-observer": "3.0.0-next.3",
    "@solid-primitives/media": "4.0.0-next.2",
    "@solid-primitives/mutation-observer": "3.0.0-next.2",
    "@solid-primitives/pointer": "1.0.0-next.2",
    "@solid-primitives/refs": "3.0.0-next.2",
    "@solid-primitives/resize-observer": "4.0.0-next.3",
    "@solid-primitives/scheduled": "2.0.0-next.2",
    "@solid-primitives/transition-group": "2.0.0-next.2",
    "@solidjs/router": "catalog:solid",
    "@solidjs/web": "catalog:solid",
    "@solidmaterial/icons": "workspace:*",
    "solid-js": "catalog:solid"
  },
  "devDependencies": {
    "@solidjs/testing-library": "catalog:testing",
    "@solidjs/vite-plugin": "catalog:vite",
    "@solidmaterial/vite-plugin-solid-svg": "workspace:*",
    "@storybook/addon-a11y": "catalog:storybook",
    "@storybook/addon-docs": "catalog:storybook",
    "@storybook/addon-vitest": "catalog:storybook",
    "@tsdown/css": "catalog:tsdown",
    "@types/node": "24.13.2",
    "@vitest/browser-playwright": "catalog:vitest",
    "@vitest/coverage-istanbul": "catalog:vitest",
    "playwright": "catalog:testing",
    "storybook": "catalog:storybook",
    "storybook-solidjs-vite": "catalog:storybook",
    "tsdown": "catalog:tsdown",
    "vite": "catalog:vite",
    "vitest": "catalog:vitest"
  },
  "peerDependencies": {
    "@solidmaterial/vite-plugin-solid-svg": "workspace:*",
    "solid-js": "^2.0.0"
  }
}
