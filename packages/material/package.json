{
  "name": "@solid-material/material",
  "version": "1.0.0",
  "private": false,
  "description": "Material 3 Expressive for SolidJS",
  "keywords": [
    "components",
    "design system",
    "expressive",
    "material",
    "material design",
    "solid",
    "solidjs",
    "ui"
  ],
  "bugs": {
    "url": "https://github.com/mprovok/solid-material/issues"
  },
  "license": "Apache-2.0",
  "author": "Mark Provo Kluit",
  "repository": {
    "type": "git",
    "url": "https://github.com/mprovok/solid-material",
    "directory": "packages/material"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./components/*": {
      "types": "./src/components/*/index.d.ts",
      "default": "./src/components/*/index.ts"
    },
    "./layouts": {
      "types": "./src/layouts/index.d.ts",
      "default": "./src/layouts/index.ts"
    },
    "./styling": {
      "types": "./src/styling/index.d.ts",
      "default": "./src/styling/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.d.ts",
      "default": "./src/utils/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.ts"
      },
      "./components/*": {
        "types": "./dist/components/*/index.d.ts",
        "default": "./dist/components/*/index.js"
      },
      "./layouts": {
        "types": "./dist/layouts/index.d.ts",
        "default": "./dist/layouts/index.js"
      },
      "./styling": {
        "types": "./dist/styling/index.d.ts",
        "default": "./dist/styling/index.js"
      },
      "./utils": {
        "types": "./dist/utils/index.d.ts",
        "default": "./dist/utils/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test:chromium": "vitest run --browser chromium",
    "test:webkit": "vitest run --coverage --browser webkit",
    "test": "pnpm run test:webkit",
    "lint": "oxlint --report-unused-disable-directives",
    "lint:fix": "oxlint --fix --report-unused-disable-directives",
    "storybook": "storybook dev --port 6006 --no-version-updates --no-open --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "5.2.8",
    "@material/material-color-utilities": "0.4.0",
    "@material/web": "2.4.1",
    "@solid-material/icons": "workspace:*",
    "@solid-primitives/active-element": "2.1.6",
    "@solid-primitives/intersection-observer": "2.2.5",
    "@solid-primitives/media": "2.3.6",
    "@solid-primitives/mutation-observer": "1.2.4",
    "@solid-primitives/pointer": "0.3.6",
    "@solid-primitives/refs": "1.1.4",
    "@solid-primitives/resize-observer": "2.1.6",
    "@solid-primitives/scheduled": "1.5.3",
    "@solid-primitives/transition-group": "1.1.2",
    "@solidjs/router": "catalog:solid",
    "solid-js": "catalog:solid"
  },
  "devDependencies": {
    "@solid-material/vite-plugin-solid-svg": "workspace:*",
    "@storybook/addon-a11y": "catalog:storybook",
    "@storybook/addon-docs": "catalog:storybook",
    "@storybook/addon-vitest": "catalog:storybook",
    "@tsdown/css": "catalog:tsdown",
    "@types/node": "24.13.2",
    "@vitest/browser-playwright": "catalog:vitest",
    "@vitest/coverage-istanbul": "catalog:vitest",
    "playwright": "1.59.1",
    "storybook": "catalog:storybook",
    "storybook-solidjs-vite": "catalog:storybook",
    "tsdown": "catalog:tsdown",
    "vite": "catalog:vite",
    "vite-plugin-solid": "catalog:vite",
    "vitest": "catalog:vitest"
  },
  "peerDependencies": {
    "@solid-material/vite-plugin-solid-svg": "workspace:*",
    "solid-js": "^1.9.0"
  }
}
