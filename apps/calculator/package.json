    "decimal.js": "10.6.0",
    "solid-js": "catalog:solid"
  },
  "devDependencies": {
    "@solidjs/testing-library": "catalog:testing",
    "@solidjs/vite-plugin": "catalog:vite",
    "@solidmaterial/vite-plugin-solid-svg": "workspace:*",
    "@vitest/browser-playwright": "catalog:vitest",
